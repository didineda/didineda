

# ==============================================
# 1. الطبقة الأساسية (Application)
# ==============================================

class RadioPlayerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("📻 مشغل الصوتيات - القرآن والإذاعات")
        self.root.geometry("900x650")
        self.root.minsize(800, 500)

        # متغيرات التشغيل
        self.current_radio_id = None
        self.current_radio_name = None
        self.is_playing = False
        self.player = None  # كائن VLC

        # قاعدة البيانات
        self.db_path = "radios.db"
        if not os.path.exists(self.db_path):
            messagebox.showerror("خطأ", f"قاعدة البيانات '{self.db_path}' غير موجودة!\nيرجى تشغيل سكربت الاستيراد أولاً.")
            self.root.destroy()
            return

        # واجهة المستخدم
        self.build_ui()

        # تحميل التصنيفات
        self.load_categories()

    def build_ui(self):
        """بناء مكونات الواجهة"""
        # الإطار العلوي (عنوان + بحث)
        top_frame = tk.Frame(self.root, bg="#2c3e50", height=70)
        top_frame.pack(fill=tk.X, side=tk.TOP)

        title_label = tk.Label(top_frame, text="📻 مشغل الصوتيات المتقدم", font=("Arial", 20, "bold"),
                               fg="white", bg="#2c3e50")
        title_label.place(relx=0.5, rely=0.5, anchor=tk.CENTER)

        # إطار البحث
        search_frame = tk.Frame(self.root, bg="#ecf0f1", pady=5)
        search_frame.pack(fill=tk.X, side=tk.TOP)

        tk.Label(search_frame, text="🔍 بحث:", font=("Arial", 12), bg="#ecf0f1").pack(side=tk.LEFT, padx=10)
        self.search_var = tk.StringVar()
        self.search_var.trace("w", lambda *args: self.search_radios())
        search_entry = tk.Entry(search_frame, textvariable=self.search_var, font=("Arial", 12), width=40)
        search_entry.pack(side=tk.LEFT, padx=5)

        # الإطار الرئيسي (تصنيفات + قائمة الإذاعات)
        main_frame = tk.Frame(self.root)
        main_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        # --- القسم الأيسر: التصنيفات ---
        left_frame = tk.LabelFrame(main_frame, text="📂 التصنيفات", font=("Arial", 12, "bold"))
        left_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=False, padx=(0, 10))

        self.categories_listbox = tk.Listbox(left_frame, font=("Arial", 11), height=20, width=25,
                                             selectmode=tk.SINGLE, activestyle="dotbox")
        self.categories_listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.categories_listbox.bind('<<ListboxSelect>>', self.on_category_select)

        scrollbar_cat = tk.Scrollbar(left_frame, orient=tk.VERTICAL, command=self.categories_listbox.yview)
        scrollbar_cat.pack(side=tk.RIGHT, fill=tk.Y)
        self.categories_listbox.config(yscrollcommand=scrollbar_cat.set)

        # --- القسم الأيمن: الإذاعات ---
        right_frame = tk.LabelFrame(main_frame, text="🎵 الإذاعات / الصوتيات", font=("Arial", 12, "bold"))
        right_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

        # إطار داخلي للقائمة مع سكرول
        list_container = tk.Frame(right_frame)
        list_container.pack(fill=tk.BOTH, expand=True)

        self.radios_listbox = tk.Listbox(list_container, font=("Arial", 11), height=20,
                                         selectmode=tk.SINGLE, activestyle="dotbox")
        self.radios_listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.radios_listbox.bind('<<ListboxSelect>>', self.on_radio_select)
        self.radios_listbox.bind('<Double-Button-1>', lambda e: self.play_selected())

        scrollbar_radio = tk.Scrollbar(list_container, orient=tk.VERTICAL, command=self.radios_listbox.yview)
        scrollbar_radio.pack(side=tk.RIGHT, fill=tk.Y)
        self.radios_listbox.config(yscrollcommand=scrollbar_radio.set)

        # --- الإطار السفلي (أزرار التحكم وحالة التشغيل) ---
        control_frame = tk.Frame(self.root, bg="#34495e", height=80)
        control_frame.pack(fill=tk.X, side=tk.BOTTOM)

        # زر التشغيل
        self.play_btn = tk.Button(control_frame, text="▶ تشغيل", font=("Arial", 14, "bold"),
                                  bg="#27ae60", fg="white", padx=20, pady=8,
                                  command=self.play_selected)
        self.play_btn.place(relx=0.3, rely=0.5, anchor=tk.CENTER)

        # زر الإيقاف
        self.stop_btn = tk.Button(control_frame, text="⏹ إيقاف", font=("Arial", 14, "bold"),
                                  bg="#e74c3c", fg="white", padx=20, pady=8,
                                  command=self.stop_radio)
        self.stop_btn.place(relx=0.5, rely=0.5, anchor=tk.CENTER)

        # حالة التشغيل
        self.status_label = tk.Label(control_frame, text="⏸ متوقف", font=("Arial", 12),
                                     fg="white", bg="#34495e")
        self.status_label.place(relx=0.7, rely=0.5, anchor=tk.CENTER)

        # شريط التقدم الوهمي (لتحديث الحالة فقط)
        self.progress_var = tk.DoubleVar()
        self.progress_bar = ttk.Progressbar(control_frame, variable=self.progress_var,
                                            length=150, mode='determinate')
        self.progress_bar.place(relx=0.85, rely=0.5, anchor=tk.CENTER)

        # تحديث واجهة التشغيل بشكل دوري
        self.update_ui_loop()

    # ==============================================
    # 2. دوال قاعدة البيانات
    # ==============================================

    def get_db_connection(self):
        return sqlite3.connect(self.db_path)

    def load_categories(self):
        """تحميل جميع التصنيفات من قاعدة البيانات"""
        self.categories_listbox.delete(0, tk.END)
        conn = self.get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT name FROM categories ORDER BY name")
        rows = cursor.fetchall()
        for row in rows:
            self.categories_listbox.insert(tk.END, row[0])
        conn.close()

        # اختيار أول تصنيف تلقائياً
        if self.categories_listbox.size() > 0:
            self.categories_listbox.selection_set(0)
            self.on_category_select(None)

    def load_radios(self, category_name=None, search_term=None):
        """تحميل الإذاعات بناءً على التصنيف أو البحث"""
        self.radios_listbox.delete(0, tk.END)
        conn = self.get_db_connection()
        cursor = conn.cursor()

        if search_term:
            # بحث متقدم: استخدام FTS إذا كان مدعوماً، وإلا بحث LIKE
            try:
                # محاولة استخدام FTS5 أولاً
                cursor.execute('''
                    SELECT r.id, r.name 
                    FROM radios_fts fts
                    JOIN radios r ON fts.id = r.id
                    WHERE fts.name MATCH ? OR fts.category_name MATCH ?
                    ORDER BY r.name
                ''', (search_term, search_term))
                rows = cursor.fetchall()
                if not rows:
                    raise sqlite3.OperationalError("FTS no results")
            except:
                # الرجوع إلى البحث العادي (LIKE)
                cursor.execute('''
                    SELECT r.id, r.name 
                    FROM radios r
                    JOIN categories c ON r.category_id = c.id
                    WHERE r.name LIKE ? OR c.name LIKE ?
                    ORDER BY r.name
                ''', (f'%{search_term}%', f'%{search_term}%'))
                rows = cursor.fetchall()
        else:
            if category_name:
                cursor.execute('''
                    SELECT r.id, r.name 
                    FROM radios r
                    JOIN categories c ON r.category_id = c.id
                    WHERE c.name = ?
                    ORDER BY r.name
                ''', (category_name,))
            else:
                cursor.execute("SELECT id, name FROM radios ORDER BY name")
            rows = cursor.fetchall()

        # تخزين الـ IDs في قاموس مرتبط بموضع الـ Listbox
        self.radio_items = {}  # index -> radio_id
        for idx, (radio_id, name) in enumerate(rows):
            self.radios_listbox.insert(tk.END, name)
            self.radio_items[idx] = radio_id

        conn.close()

    def search_radios(self):
        """استدعاء عند تغيير نص البحث"""
        search_text = self.search_var.get().strip()
        if search_text:
            self.load_radios(search_term=search_text)
        else:
            # العودة للتصنيف المحدد
            selected = self.categories_listbox.curselection()
            if selected:
                cat_name = self.categories_listbox.get(selected[0])
                self.load_radios(category_name=cat_name)
            else:
                self.load_radios()

    def on_category_select(self, event):
        """عند اختيار تصنيف"""
        selected = self.categories_listbox.curselection()
        if selected:
            cat_name = self.categories_listbox.get(selected[0])
            self.search_var.set("")  # إفراغ حقل البحث
            self.load_radios(category_name=cat_name)

    def on_radio_select(self, event):
        """عند اختيار إذاعة من القائمة"""
        selected = self.radios_listbox.curselection()
        if selected:
            index = selected[0]
            radio_id = self.radio_items.get(index)
            if radio_id:
                self.current_radio_id = radio_id
                self.current_radio_name = self.radios_listbox.get(index)

    # ==============================================
    # 3. دوال التشغيل (VLC)
    # ==============================================

    def get_radio_url(self, radio_id):
        """جلب رابط البث من قاعدة البيانات"""
        conn = self.get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT radio_url FROM radios WHERE id = ?", (radio_id,))
        row = cursor.fetchone()
        conn.close()
        return row[0] if row else None

    def play_selected(self):
        """تشغيل الإذاعة المحددة"""
        if not self.current_radio_id:
            messagebox.showwarning("تنبيه", "الرجاء اختيار إذاعة أولاً.")
            return

        # إيقاف التشغيل الحالي إن وجد
        if self.is_playing:
            self.stop_radio()

        url = self.get_radio_url(self.current_radio_id)
        if not url:
            messagebox.showerror("خطأ", "لا يمكن العثور على رابط لهذه الإذاعة.")
            return

        try:
            # إنشاء كائن VLC جديد
            self.player = vlc.MediaPlayer(url)
            self.player.play()

            # تأخير بسيط للتحقق من بدء التشغيل
            time.sleep(0.5)
            if self.player.is_playing():
                self.is_playing = True
                self.status_label.config(text=f"▶ تشغيل: {self.current_radio_name}", fg="#2ecc71")
                self.play_btn.config(text="⏸ إيقاف مؤقت", bg="#f39c12", command=self.pause_radio)
                self.progress_var.set(100)  # شريط ثابت أثناء البث
                self.update_ui_loop()
            else:
                # إذا لم يعمل، حاول باستخدام رابط بديل (تنظيف)
                cleaned_url = url.replace("http://", "https://") if "http://" in url else url
                self.player = vlc.MediaPlayer(cleaned_url)
                self.player.play()
                time.sleep(0.5)
                if self.player.is_playing():
                    self.is_playing = True
                    self.status_label.config(text=f"▶ تشغيل (بديل): {self.current_radio_name}", fg="#2ecc71")
                    self.play_btn.config(text="⏸ إيقاف مؤقت", bg="#f39c12", command=self.pause_radio)
                else:
                    messagebox.showerror("فشل التشغيل", "لا يمكن تشغيل هذا الرابط. تأكد من اتصال الإنترنت أو صلاحية الرابط.")
                    self.player = None
                    self.is_playing = False

        except Exception as e:
            messagebox.showerror("خطأ في المشغل", f"حدث خطأ أثناء التشغيل:\n{str(e)}")
            self.is_playing = False

    def pause_radio(self):
        """إيقاف التشغيل مؤقتاً (Pause)"""
        if self.player and self.is_playing:
            self.player.pause()
            self.is_playing = False
            self.status_label.config(text="⏸ متوقف مؤقتاً", fg="#f1c40f")
            self.play_btn.config(text="▶ متابعة", bg="#27ae60", command=self.resume_radio)

    def resume_radio(self):
        """استئناف التشغيل"""
        if self.player:
            self.player.play()
            self.is_playing = True
            self.status_label.config(text=f"▶ تشغيل: {self.current_radio_name}", fg="#2ecc71")
            self.play_btn.config(text="⏸ إيقاف مؤقت", bg="#f39c12", command=self.pause_radio)

    def stop_radio(self):
        """إيقاف التشغيل نهائياً"""
        if self.player:
            self.player.stop()
            self.player = None
        self.is_playing = False
        self.status_label.config(text="⏸ متوقف", fg="white")
        self.play_btn.config(text="▶ تشغيل", bg="#27ae60", command=self.play_selected)
        self.progress_var.set(0)

    # ==============================================
    # 4. تحديث الواجهة (Loop)
    # ==============================================

    def update_ui_loop(self):
        """تحديث حالة التشغيل في الخلفية (كل ثانية)"""
        if self.player and self.is_playing:
            # لا نستطيع جلب التقدم في البث المباشر، فقط نترك الشريط ممتلئاً
            pass
        self.root.after(1000, self.update_ui_loop)

# ==============================================
# 5. تشغيل التطبيق
# ==============================================

if __name__ == "__main__":
    root = tk.Tk()
    app = RadioPlayerApp(root)
    root.mainloop()
